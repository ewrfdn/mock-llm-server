# ---- Mock LLM Server ----
# API 服务监听地址。默认只监听本机；需要局域网访问时改成 0.0.0.0。
HOST=127.0.0.1
PORT=8787

# 对外展示地址（MCP / Skill / 文档里使用），默认按 HOST:PORT 推导
# PUBLIC_BASE_URL=http://localhost:8787

# SQLite 数据目录（相对仓库根目录）或直接指定 DB_PATH
DATA_DIR=./data
# DB_PATH=./data/mock-llm.db

# 可选：配置后启用 QPM / TPM 限流；不配置时限流不生效，但服务照常可用。
# REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PREFIX=mockllm

# 首次启动的管理台 API Key。留空则自动生成并写入 data/bootstrap-key.txt
# BOOTSTRAP_API_KEY=mllm_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 是否在空数据库时创建 3 个演示模型
SEED_DEMO=true

# 单次生成允许的最大输出 token 数（防止误配置把内存打满）
MAX_OUTPUT_TOKENS=1000000

# 模拟缓存
CACHE_TTL_MS=600000
CACHE_MAX_ENTRIES=300
CACHE_MAX_CHARS=200000

# 每个请求都打印访问日志（高并发压测时建议关闭）
LOG_REQUESTS=false
LOG_LEVEL=info

# 允许的跨域来源，* 表示全部
CORS_ORIGIN=*

# 请求历史保留条数（默认 2 万条）
REQUESTS_RETENTION=20000
